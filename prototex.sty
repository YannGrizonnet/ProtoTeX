\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{prototex}[2026/10/25 v0.1 Card layout prototype]
\RequirePackage{tikz}
\RequirePackage{graphicx}
\RequirePackage{xparse}
\makeatletter
% Lengths are expressed in millimetres, rows count from top (1-based).
\newcommand\ProtoSetup[1]{\pgfkeys{/prototex/setup/.cd,#1}}
\newcommand\ProtoLayout[1]{\pgfkeys{/prototex/layout/.cd,#1}}
\newcommand\ProtoCard[1][]{%
  \begingroup
  \pgfkeys{/prototex/card/.cd,title={},image={},description={},number={},#1}%
  \ProtoRenderCard
  \endgroup
}
\pgfkeys{/prototex/setup/.is family,/prototex/setup,
  width/.store in=\pt@width,width=63,
  height/.store in=\pt@height,height=88,
  rows/.store in=\pt@rows,rows=12,
  padding/.store in=\pt@padding,padding=3,
  band-color/.store in=\pt@bandcolor,band-color=black!65,
  border-color/.store in=\pt@bordercolor,border-color=black,
  paper-color/.store in=\pt@papercolor,paper-color=white,
}
\pgfkeys{/prototex/layout/.is family,/prototex/layout,
  title-row/.store in=\pt@titlerow,title-row=2,
  title-align/.store in=\pt@titlealign,title-align=center,
  image-from/.store in=\pt@imagefrom,image-from=4,
  image-to/.store in=\pt@imageto,image-to=7,
  description-from/.store in=\pt@descfrom,description-from=9,
  description-to/.store in=\pt@descto,description-to=10,
  description-align/.store in=\pt@descalign,description-align=left,
  number-row/.store in=\pt@numberrow,number-row=12,
  number-align/.store in=\pt@numberalign,number-align=right,
}
\pgfkeys{/prototex/card/.is family,/prototex/card,
  title/.store in=\pt@title,
  image/.store in=\pt@image,
  description/.store in=\pt@description,
  number/.store in=\pt@number,
}
\ProtoSetup{}
\ProtoLayout{}
% Coordinate helpers: the origin is at the top left; positive y goes down.
\newcommand\pt@rowcenter[1]{((#1)-0.5)*\pt@height/\pt@rows}
\newcommand\pt@rowtop[1]{((#1)-1)*\pt@height/\pt@rows}
\newcommand\pt@rowbottom[1]{(#1)*\pt@height/\pt@rows}
\newcommand\pt@align[1]{%
  \def\pt@anchor{center}%
  \def\pt@x{\pt@width/2}%
  \edef\pt@asked{#1}%
  \def\pt@left{left}\def\pt@right{right}%
  \ifx\pt@asked\pt@left
    \def\pt@anchor{west}\def\pt@x{\pt@padding}%
  \else\ifx\pt@asked\pt@right
    \def\pt@anchor{east}\def\pt@x{\pt@width-\pt@padding}%
  \fi\fi
}
\newcommand\ProtoRenderCard{%
\begin{tikzpicture}[x=1mm,y=-1mm,baseline=(current bounding box.north)]
  \path[use as bounding box] (0,0) rectangle (\pt@width,\pt@height);
  \fill[\pt@papercolor] (0,0) rectangle (\pt@width,\pt@height);
  \fill[\pt@bandcolor] (0,{\pt@rowtop{\pt@titlerow}}) rectangle (\pt@width,{\pt@rowbottom{\pt@titlerow}});
  \pt@align{\pt@titlealign}
  \node[anchor=\pt@anchor,inner sep=0,outer sep=0,text=white,font=\bfseries\small]
    at ({\pt@x},{\pt@rowcenter{\pt@titlerow}}) {\pt@title};
  % Illustration zone: fixed frame, with centred, aspect-ratio-preserving image.
  \pgfmathsetmacro\pt@imgtop{\pt@rowtop{\pt@imagefrom}}
  \pgfmathsetmacro\pt@imgbottom{\pt@rowbottom{\pt@imageto}}
  \pgfmathsetmacro\pt@imgheight{\pt@imgbottom-\pt@imgtop-2}
  \pgfmathsetmacro\pt@imgwidth{\pt@width-2*\pt@padding-2}
  \draw[black!35] (\pt@padding,\pt@imgtop) rectangle ({\pt@width-\pt@padding},\pt@imgbottom);
  \ifx\pt@image\@empty\else
    \node[inner sep=0,outer sep=0] at ({\pt@width/2},{(\pt@imgtop+\pt@imgbottom)/2})
      {\includegraphics[width=\pt@imgwidth mm,height=\pt@imgheight mm,keepaspectratio]{\pt@image}};
  \fi
  \pt@align{\pt@descalign}
  \pgfmathsetmacro\pt@textwidth{\pt@width-2*\pt@padding}
  \node[anchor=north west,inner sep=0,outer sep=0,text width=\pt@textwidth mm,
        font=\footnotesize,align=\pt@descalign]
    at (\pt@padding,{\pt@rowtop{\pt@descfrom}}) {\pt@description};
  \pt@align{\pt@numberalign}
  \node[anchor=\pt@anchor,inner sep=0,outer sep=0,font=\scriptsize]
    at ({\pt@x},{\pt@rowcenter{\pt@numberrow}}) {\pt@number};
  \draw[\pt@bordercolor,line width=0.35mm,rounded corners=2mm]
    (0,0) rectangle (\pt@width,\pt@height);
\end{tikzpicture}%
}
\makeatother
